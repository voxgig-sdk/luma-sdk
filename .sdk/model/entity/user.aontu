# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: [
    {
      name: "avatar_url"
      req: true
      type: "`$STRING`"
    }
    {
      name: "email"
      req: true
      type: "`$STRING`"
    }
    {
      name: "first_name"
      req: true
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      name: "last_name"
      req: true
      type: "`$ANY`"
    }
    {
      name: "name"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "user"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/v1/users/get-self"
          parts: [
            "v1"
            "users"
            "get-self"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
