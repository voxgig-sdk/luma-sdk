      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ticket_type_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "ticket_type_ref01",
        srcdatavar: "ticket_type_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-ticket_type_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "ticket_type_ref01",
        suffix: "_rm0"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "ticket_type_ref01"
          }
