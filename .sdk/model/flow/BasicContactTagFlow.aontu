# BasicContactTagFlow

main: kit: flow: BasicContactTagFlow:
{
  entity: "contact_tag",
  kind: "basic",
  name: "BasicContactTagFlow",
  step: [
    {
      input: {
        ref: "contact_tag_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "contact_tag_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "contact_tag_ref01",
        srcdatavar: "contact_tag_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-contact_tag_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "contact_tag_ref01",
        suffix: "_rm0"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "contact_tag_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicContactTagFlow"
}