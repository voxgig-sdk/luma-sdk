# BasicCalendarEventFlow

main: kit: flow: BasicCalendarEventFlow:
{
  entity: "calendar_event",
  kind: "basic",
  name: "BasicCalendarEventFlow",
  step: [
    {
      input: {
        ref: "calendar_event_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "calendar_event_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "calendar_event_ref01",
        srcdatavar: "calendar_event_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-calendar_event_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCalendarEventFlow"
}